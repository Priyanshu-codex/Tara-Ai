# ==============================================================================
# TARA AI — Environment Variables Configuration
# ==============================================================================
# Copy this file to .env.local and configure your credentials.
#
# Note: TARA AI includes an autonomous pedagogical fallback engine for Tara.
# If external AI keys are not provided, the platform functions seamlessly using
# curriculum-aligned pedagogical responses and demo mode.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. AI Engine Providers (Tara Learning Buddy)
# ------------------------------------------------------------------------------
# Google Gemini API Key for Gemini 1.5 Flash models
GEMINI_API_KEY=

# OpenAI API Key (optional alternative for GPT models)
OPENAI_API_KEY=

# ------------------------------------------------------------------------------
# 2. Supabase Configuration (Database & Authentication)
# ------------------------------------------------------------------------------
# Your Supabase Project URL (e.g., https://your-project.supabase.co)
NEXT_PUBLIC_SUPABASE_URL=

# Supabase Public Anonymous API Key (safe for browser exposure)
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase Service Role Secret Key (server-side only, bypasses RLS)
SUPABASE_SERVICE_ROLE_KEY=

# ------------------------------------------------------------------------------
# 3. Application Settings
# ------------------------------------------------------------------------------
# Application Base URL
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Node Environment
NODE_ENV=development
